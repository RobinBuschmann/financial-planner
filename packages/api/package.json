{
  "name": "@financial-planner/api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/migrate.ts && npm run generate:spec",
    "dev": "tsx watch src/index.ts",
    "prestart": "tsx scripts/migrate.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src/ scripts/",
    "test": "vitest run",
    "test:types": "tsc",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "build": "npm run generate:spec",
    "generate:spec": "tsx scripts/generate-openapi-spec.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "better-sqlite3": "^11.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.9",
    "glob": "^13.0.6",
    "tsx": "^4.0.0"
  }
}
