{
  "name": "@financial-planner/web",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:env-types": "node scripts/generate-env-types.mjs",
    "generate:api-client": "openapi-typescript ../api/openapi.json -o src/core/http/schema.d.ts",
    "predev": "npm run generate:env-types && npm run generate:api-client",
    "prebuild": "npm run generate:env-types && npm run generate:api-client",
    "dev": "vite --port=3001",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint src/ scripts/",
    "test": "vitest run",
    "test:types": "tsc"
  },
  "dependencies": {
    "@financial-planner/api": "*",
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-form-devtools": "^0.2.16",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.163.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.166.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "vite": "^7.3.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
